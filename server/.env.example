# ─────────────────────────────────────────────────────────────
#  Copy this file to ".env" (same folder) and fill in YOUR values.
#  NEVER commit .env to GitHub (it is already in .gitignore).
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
# URL the React app runs on (used for CORS)
CLIENT_URL=http://localhost:5173

# MySQL  ←  YOU PROVIDE: the root password you set while installing MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=taskflow
# Set to true only for cloud MySQL (Aiven, etc.) that requires SSL
DB_SSL=false

# JWT  ←  YOU PROVIDE: a long random string. Generate one with:  npm run gen:secret
JWT_SECRET=paste_a_long_random_string_here
JWT_EXPIRES_IN=1d

# First admin account  ←  YOU PROVIDE: any email + password you want to log in with
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@taskflow.com
ADMIN_PASSWORD=ChangeMe@123

# Set to true to also create 3 demo members + sample tasks (nice for demos/screenshots)
SEED_DEMO_DATA=true
